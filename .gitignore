# Python 字节码缓存
__pycache__/
*.py[cod]

# Godot 编译产物（由 remake/build_assets.py 重新生成，252MB，不入库）
remake/godot/assets/

# Godot 导入缓存（.import 产物，可重建）
remake/godot/.godot/

# Godot 运行时 HOME（字体/着色器缓存，2.8MB）
.godot_home/

# 编辑器/OS 杂项
.DS_Store
*.swp
remake/fonts/*.ttc

# 参考视频（518MB，仅供人工对照；结论以 exe 反汇编为准）
geki.mp4
state.dat

# 本地录屏、音频和原始帧
/tmp_work/video/

# 原作解包资源不入公开库（见 README 使用声明）；唯一例外是流程脚本及其文本 dump
extracted/*
!extracted/script/
!extracted/script_txt/
resource_dec.bin
